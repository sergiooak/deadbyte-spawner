NODE_ENV=development

DATABASE_URL=postgres://deadbyte:SUA_SENHA_AQUI@localhost:5432/deadbyte

# Senha do painel. Mínimo de 16 caracteres; sem ela o painel fica bloqueado em produção.
# Gere uma com: openssl rand -base64 32
DEADBYTE_ADMIN_PASSWORD=

# Token só leitura da API de logs (/api/logs). 32+ caracteres. Vazio desliga o acesso por token.
DEADBYTE_LOGS_TOKEN=

DEADBYTE_DATA_DIR=./.deadbyte
DEADBYTE_REPOS_DIR=./.deadbyte/repos
DEADBYTE_INSTANCES_DIR=./.deadbyte/instances
DEADBYTE_SESSIONS_DIR=./.deadbyte/sessions
DEADBYTE_LOGS_DIR=./.deadbyte/logs

DEADBYTE_BOT_DEFAULT_REPOSITORY_URL=https://github.com/sergiooak/deadbyte-bot.git
DEADBYTE_BOT_DEFAULT_BRANCH=main

DEADBYTE_INTERNAL_HOST=127.0.0.1
DEADBYTE_INTERNAL_PORT_START=41000
DEADBYTE_INTERNAL_PORT_END=41999

# Dias que logs e eventos dos bots ficam no banco (0 desativa a limpeza).
# 180 = 6 meses do Marco Civil da Internet (art. 15); a LGPD não fixa prazo, só exige finalidade.
DEADBYTE_LOG_RETENTION_DAYS=180

DEADBYTE_CHROME_PATH=
FFMPEG_PATH=
FFPROBE_PATH=

# Repassadas para os bots (modo managed herda o ambiente do spawner).
DEADBYTE_REMBG_URL=http://localhost:7000
DEADBYTE_TEXAS_API_KEY=
DEADBYTE_TTP_API_KEY=
DEADBYTE_TYPESAFE_API_KEY=
DEADBYTE_OPENAI_API_KEY=
